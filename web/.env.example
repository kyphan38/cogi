# Copy to .env.local and set your keys (never commit .env.local)
# Firebase Web SDK config (public values; safe to expose in NEXT_PUBLIC_ env vars).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional but recommended if present in your Firebase project settings.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Single-user allowlist (set at least one, UID preferred).
NEXT_PUBLIC_ALLOWED_USER_UID=
NEXT_PUBLIC_ALLOWED_EMAIL=
# Server-side allowlist (used by `/api/ai/*` + session API + Edge proxy when set; prefer UID).
ALLOWED_USER_UID=
ALLOWED_USER_EMAIL=

# Firebase Admin SDK (server-only, never expose to client).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep literal \n in .env.local for multiline key.
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional auth-session tuning
# AUTH_COOKIE_NAME=cogi_session
# AUTH_COOKIE_MAX_AGE_SECONDS=3300

# For `npm run gate:phase0` against a running dev server (not stored in .env by default):
# GATE_ID_TOKEN=<Firebase ID token for an allowlisted user>

# Google AI Studio / Generative Language API key (no quotes; avoid trailing spaces).
GEMINI_API_KEY=
# Optional override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_THINKING=gemini-3.5-flash

# If migrating to Anthropic (see docs/MIGRATE_GEMINI_TO_CLAUDE.md), wire these in code first:
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=   # model id from Anthropic console
