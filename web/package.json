{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbopack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "gate:phase0": "node ./scripts/phase0-gate.mjs",
    "test:unit": "vitest run",
    "test:e2e": "npx playwright test --workers=1",
    "test": "npm run test:unit && npm run test:e2e",
    "test:watch": "vitest",
    "test:perspective": "npx tsx src/lib/ai/validators/perspective-structured.spec.ts",
    "test:e2e:features": "npx playwright test --reporter=list",
    "test:e2e:ui": "npx playwright test --ui",
    "test:layout": "npx playwright test tests/ui-ux/layout-architecture.spec.ts",
    "check:exercise-domains": "node scripts/exercise-domains-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@google/genai": "^2.32.0",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "jose": "^6.2.18",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.1",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
