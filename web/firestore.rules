rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAllowedCollection(collectionName) {
      // Client-side collections only (see COGI_COLLECTIONS in src/lib/db/firestore.ts).
      // aiArtifacts is written by the server with the Admin SDK, which bypasses rules.
      return collectionName in [
        "cachedTopicLists",
        "exercises",
        "practicedTopics",
        "settings"
      ];
    }

    match /users/{uid}/{collectionName}/{docId} {
      allow read, write: if isOwner(uid) && isAllowedCollection(collectionName);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
