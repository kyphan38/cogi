rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Single-user app: only this verified Google account may use the database.
    function allowed() {
      return request.auth != null
        && request.auth.token.email == 'kyphan.work@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isOwner(uid) {
      return allowed() && request.auth.uid == uid;
    }

    function isAllowedCollection(collectionName) {
      // Client-side collections only (see COGI_COLLECTIONS in src/lib/db/firestore.ts).
      // aiArtifacts is written by the server with the Admin SDK, which bypasses rules.
      return collectionName in [
        "cachedTopicLists",
        "exercises",
        "practicedTopics",
        "settings"
      ];
    }

    match /users/{uid}/{collectionName}/{docId} {
      allow read, write: if isOwner(uid) && isAllowedCollection(collectionName);
    }

    // AI cost per month (YYYY-MM). Admin SDK only: the hub /costs page reads it.
    match /aiUsage/{month} {
      allow read: if false;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
